#: audio_plugin.cpp:74
#, kde-format
msgid "An older file named '%1' already exists.\n"
msgstr "'%1' పేరుతో ఒక పాత ఫైల్ ఇప్పటికేవుంది.\n"

#: audio_plugin.cpp:76
#, kde-format
msgid "A similar file named '%1' already exists.\n"
msgstr "'%1' పేరుతో అటువంటి ఫైలు ఇప్పటికేవుంది.\n"

#: audio_plugin.cpp:78
#, kde-format
msgid "A newer file named '%1' already exists.\n"
msgstr "'%1' పేరుతో ఒక కొత్త ఫైల్ ఇప్పటికేవుంది.\n"

#: audio_plugin.cpp:80
#, kde-format
msgid "Source File"
msgstr "మూలాధార ఫైల్"

#: audio_plugin.cpp:81
#, kde-format
msgid "Existing File"
msgstr "ఇప్పటికేవున్న ఫైల్"

#: audio_plugin.cpp:82
#, kde-format
msgid "Would you like to replace the existing file with the one on the right?"
msgstr "ఇప్పుడువున్న ఫైలుపై తిరిగిస్థాపించాలని అనుకుంటున్నారా?"

#: audiopreview.cpp:51
#, kde-format
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"స్థానిక హోస్ట్ నందు ఈ ఆడియో ఫైల్‌ \n"
"నిల్వవుంచబడదు.\n"
"దానిని లోడ్‌చేయుటకు ఈ లేబుల్‌ను నొక్కుము.\n"

#: audiopreview.cpp:57
#, kde-format
msgid "Unable to load audio file"
msgstr "ఆడియో ఫైల్‌ను లోడ్‌ చేయలేకపోయింది"

#: audiopreview.cpp:88
#, kde-format
msgid "Artist: %1"
msgstr "కళాకారుడు: %1"

#: audiopreview.cpp:91
#, kde-format
msgid "Title: %1"
msgstr "శీర్షిక: %1"

#: audiopreview.cpp:94
#, kde-format
msgid "Comment: %1"
msgstr "వ్యాఖ్య: %1"

#: audiopreview.cpp:96
#, kde-format
msgctxt "Bitrate: 160 kbits/s"
msgid "Bitrate: %1 %2\n"
msgstr "బిట్‌ రేట్: %1 %2\n"

#: audiopreview.cpp:98
#, kde-format
msgid "Sample rate: %1 %2\n"
msgstr "మాదిరి రేటు: %1 %2\n"

#: audiopreview.cpp:99
#, kde-format
msgid "Length: "
msgstr "నిడివి: "
