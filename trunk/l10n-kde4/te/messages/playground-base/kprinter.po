#: printwrapper.cpp:64
#, kde-format
msgid "Print Warning"
msgstr "ప్రచురణ హెచ్చరిక"

#: printwrapper.cpp:65
#, kde-format
msgid "Print Error"
msgstr "ప్రచురణ దోషం"

#: printwrapper.cpp:71
#, kde-format
msgid "Print info"
msgstr "ప్రచురణ సమచారం"

#: printwrapper.cpp:71
#, kde-format
msgid "Print warning"
msgstr "ప్రచురణ హెచ్చరిక"

#: printwrapper.cpp:71
#, kde-format
msgid "Print error"
msgstr "ప్రచురణ దోషం"

#: printwrapper.cpp:187
#, kde-format
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr ""

#: printwrapper.cpp:193
#, kde-format
msgid ""
"When using '--nodialog', you must at least specify one file to print or use "
"the '--stdin' flag."
msgstr ""

#: printwrapper.cpp:242
#, kde-format
msgid "The specified printer or the default printer could not be found."
msgstr "నిర్దెశించిన ప్రింటర్ లేక అప్రమేయ ప్రింటర్ ను దొరకలేదు:"

#: printwrapper.cpp:244
#, kde-format
msgid "Operation aborted."
msgstr "పని వదిలేయటమైనది"

#: printwrapper.cpp:274
#, kde-format
msgid "Unable to construct the print dialog."
msgstr "ప్రచురణ డైలాగ్ ను తయారు చేయలేకపొయాను."

#: printwrapper.cpp:315
#, kde-format
msgid "Multiple files (%1)"
msgstr "ఎక్కువ దస్త్రాలు (%1)"

#: printwrapper.cpp:322
#, kde-format
msgid "Nothing to print."
msgstr "ప్రచురించేందుకు ఏమి లేదు."

#: printwrapper.cpp:347
#, kde-format
msgid "Unable to open temporary file."
msgstr "తాత్కాలిక దస్త్రాన్ని తెరువలేకపోయాను."

#: printwrapper.cpp:362
#, kde-format
msgid "Stdin is empty, no job sent."
msgstr "ఖాళీ STDIN, ఏ పని పంపించలేదు."

#: printwrapper.cpp:374
#, kde-format
msgid "Unable to copy file %1."
msgstr ""

