#: kdeui/dialogs/kaboutkdedialog_p.cpp:56
#, fuzzy
#| msgid ""
#| "The <b>K Desktop Environment</b> is written and maintained by the KDE "
#| "Team, a world-wide network of software engineers committed to <a href="
